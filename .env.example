# Copy to .env and fill in. Never commit the real .env file.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://clauseguard:clauseguard@postgres:5432/clauseguard

# --- Qdrant (legal corpus vector store) ---
# Host-mapped ports (6339/6340) are only used when connecting from outside
# Docker; containers on the compose network reach each other at qdrant:6333.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=legal_corpus_de

# --- Redis / Celery (background job processing) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- LLM reasoning provider ---
# Supported: "anthropic" | "none". "none" makes the reasoning stage return
# NOT_CONFIGURED instead of fabricating output. Contract text is only ever
# sent externally when LLM_PROVIDER=anthropic and this key is set.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=20
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.docx

# --- CORS (frontend origins allowed to call this API) ---
# Docker Compose frontend service (3005) + `npm run dev` server (3006).
CORS_ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3006
